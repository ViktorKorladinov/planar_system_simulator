# =========================================================================
# Host Port Configuration (Customize for Reverse Proxy / Server Admin)
# All host ports are strictly unprivileged (> 1024) to run without root
# =========================================================================
FE1_HOST_PORT=5173
FE2_HOST_PORT=3000
BACKEND_HOST_PORT=8000

# =========================================================================
# Database & Cache Settings (Saved exclusively in Docker named volumes)
# =========================================================================
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=dbname

# =========================================================================
# Client-Facing API and Application URLs
# (Using relative /api/v1 routes all API traffic through the internal reverse proxy)
# =========================================================================
BACKEND_PUBLIC_URL=http://localhost:8000
VITE_BACKEND_URL=/api/v1
VITE_SIMULATOR_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api/v1

# =========================================================================
# Backend CORS Allowed Origins
# =========================================================================
SIMULATOR_ALLOWED_ORIGIN=http://localhost:3000
FRONTEND_ALLOWED_ORIGIN=http://localhost:5173
