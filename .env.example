# =========================================================================
# Host Port Configuration (Customize for Reverse Proxy / Server Admin)
# All host ports are strictly unprivileged (> 1024) to run without root.
# Changing a port here automatically updates the internal URLs and CORS origins!
# =========================================================================
FE1_HOST_PORT=5173
FE2_HOST_PORT=3000
BACKEND_HOST_PORT=8000

# =========================================================================
# Database & Cache Settings (Saved exclusively in Docker named volumes)
# =========================================================================
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=dbname

# =========================================================================
# (Optional) Advanced Overrides
# You do NOT need to change these if you only changed ports above!
# Only uncomment and change these if you are binding to custom domain names
# (e.g. https://api.yourdomain.com or https://simulator.yourdomain.com).
# =========================================================================
# =========================================================================
# (Optional) Solvers (CPLEX & Gurobi)
# =========================================================================
# Default Linux container path to cpoptimizer inside the cplex_data volume:
# CPLEX_PATH=/opt/ibm/ILOG/CPLEX_Studio2211/cpoptimizer/bin/x86-64_linux/cpoptimizer
# Gurobi WLS license file location inside container:
# GRB_LICENSE_FILE=/opt/gurobi/gurobi.lic
